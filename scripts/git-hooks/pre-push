#
# pre-push: what the push would publish is held to the restricted-term list.
#
# `pre-commit` and `commit-msg` read a commit as it is made, and `--no-verify`, a cherry-pick, a
# rebase or a clone that never ran the installer reach the remote without meeting them. The push
# is the last place a local hook stands before the text is public, so it reads every line each
# pushed commit adds and every message, with the gate of the pinned `sce` (the same words as its
# own pre-push). The matched text is never printed. A gate this checkout does not have, or one
# too old to read a range, refuses the push instead of passing it.
#
# The only bypass is the gate's own, `SCE_RESTRICTED_OVERRIDE=1`, which says so and writes a row to
# the override log. Turn the hooks on once per clone: `bash scripts/git-hooks/install.sh`.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
gate="$repo_root/sce/tools/git-hooks/restricted-term-gate.sh"

if [[ ! -r "$gate" ]]; then
    printf '\nERROR pre-push: the restricted-term gate is not in this checkout (%s).\n' "$gate" >&2
    printf '  It comes with the sce submodule: git submodule update --init sce\n' >&2
    printf '  A gate that is not there is a check that was not made, so this refuses.\n' >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$gate"

if ! declare -F restricted_term_gate_pushed_refs >/dev/null; then
    printf '\nERROR pre-push: %s cannot read what a push publishes.\n' "$gate" >&2
    printf '  The pinned sce is older than the push check: git submodule update --remote sce\n' >&2
    exit 1
fi

# What a push publishes is read by the gate, from the refs git hands this hook, and by nothing
# written here: the one reading of the refs is SCE's, so this hook and SCE's own cannot disagree
# about what a push publishes.
restricted_term_gate_pushed_refs "pre-push" || exit 1
exit 0
